{
  "openapi": "3.0.3",
  "info": {"title": "PrepMateAI Mobile Authentication", "version": "2.0.0"},
  "paths": {
    "/api/v1/auth/otp/request/": {"post": {"summary": "Request an authentication OTP", "security": [], "responses": {"201": {"description": "OTP challenge created"}, "429": {"description": "Rate limited"}, "503": {"description": "SMS provider unavailable"}}}},
    "/api/v1/auth/otp/resend/": {"post": {"summary": "Replace an OTP challenge after its cooldown", "security": [], "responses": {"200": {"description": "Replacement challenge created"}, "429": {"description": "Cooldown or rate limit active"}}}},
    "/api/v1/auth/otp/verify/": {"post": {"summary": "Verify OTP and create or log in a mobile user", "security": [], "responses": {"200": {"description": "JWT tokens and user profile"}, "401": {"description": "Invalid, expired, consumed, or over-attempted OTP"}, "403": {"description": "Account disabled"}}}},
    "/api/v1/auth/token/refresh/": {"post": {"summary": "Rotate a refresh token", "responses": {"200": {"description": "New access and refresh tokens"}}}},
    "/api/v1/auth/logout/": {"post": {"summary": "Blacklist a refresh token", "responses": {"200": {"description": "Logged out"}}}},
    "/api/v1/auth/me/": {"get": {"summary": "Get the authenticated user", "responses": {"200": {"description": "User profile"}}}, "patch": {"summary": "Update optional contact/profile data", "responses": {"200": {"description": "Updated profile"}}}}
  },
  "components": {"securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}}},
  "security": [{"bearerAuth": []}]
}

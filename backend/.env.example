# Django runtime
DJANGO_SETTINGS_MODULE=core.production
DJANGO_ENV=production
DEBUG=False
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters-long
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=True

# Required production services
DATABASE_URL=postgresql://user:password@database-host:5432/prepmate
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://redis-host:6379/1
CACHE_KEY_PREFIX=prepmate
CACHE_VERSION=3
CACHE_DEFAULT_TIMEOUT=300

# Passwordless mobile OTP (required in production)
OTP_PROVIDER=fast2sms
FAST2SMS_API_KEY=replace-me
FAST2SMS_OTP_ID=replace-me
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=
FAST2SMS_ENTITY_ID=
FAST2SMS_CONNECT_TIMEOUT_SECONDS=5
FAST2SMS_REQUEST_TIMEOUT_SECONDS=10
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_ISSUES_PER_WINDOW=3
OTP_ISSUE_WINDOW_SECONDS=600
OTP_DAILY_LIMIT=10
OTP_IP_HOURLY_LIMIT=20
OTP_DEVICE_HOURLY_LIMIT=10
OTP_GLOBAL_HOURLY_LIMIT=1000
ENABLE_TEST_OTP_LOGIN=False
TEST_OTP_PHONE_NUMBERS=
TEST_OTP_CODE=

# AI provider (required for resume optimization)
OPENROUTER_API_KEY=replace-me
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=openai/gpt-4o-mini
AI_TIMEOUT_SECONDS=25
OPTIMIZER_MAX_SUGGESTIONS=5
AI_COST_RESUME_OPTIMIZATION=10
AI_COST_SUGGESTION_REGENERATION=1
AI_ADMIN_MAX_ADJUSTMENT=1000000
AI_CREDIT_MAX_BALANCE=100000000
AI_RESERVATION_STALE_MINUTES=30
OPTIMIZATION_STALE_MINUTES=30

# Production monitoring (required when DJANGO_ENV=production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SLOW_REQUEST_THRESHOLD_MS=1500

# Independent encrypted PostgreSQL backups (S3 or S3-compatible storage)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=prepmate
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ENCRYPTION=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional SMTP email delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PrepMate AI <noreply@example.com>
EMAIL_TIMEOUT=20

# JWT, private uploads, and Gunicorn
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# This example is production-oriented. Use local only in a development .env.
MEDIA_STORAGE_BACKEND=r2
MEDIA_ROOT=media
R2_MEDIA_BUCKET=
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_SIGNED_URL_EXPIRY_SECONDS=300
WEB_CONCURRENCY=2
WEB_THREADS=2
PORT=8000

# Razorpay Checkout (use Test Mode keys until end-to-end verification passes)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
PREMIUM_MONTHLY_PRICE_PAISE=9900
PREMIUM_MONTHLY_CREDITS=500
PREMIUM_ANNUAL_PRICE_PAISE=95000
PREMIUM_ANNUAL_CREDITS=6000
CREDITS_100_PRICE_PAISE=4900
CREDITS_500_PRICE_PAISE=19900
CREDITS_1500_PRICE_PAISE=49900

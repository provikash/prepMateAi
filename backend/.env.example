DJANGO_SETTINGS_MODULE=core.production
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
TRUST_PROXY_HEADERS=True
DATABASE_URL=postgresql://user:password@database-host:5432/prepmate
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://redis:6379/1
CACHE_KEY_PREFIX=prepmate
CACHE_VERSION=3
CACHE_DEFAULT_TIMEOUT=300
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=PrepMate <noreply@example.com>
OTP_PROVIDER=fast2sms
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=
FAST2SMS_ENTITY_ID=
FAST2SMS_CONNECT_TIMEOUT_SECONDS=5
FAST2SMS_REQUEST_TIMEOUT_SECONDS=10
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_ISSUES_PER_WINDOW=3
OTP_ISSUE_WINDOW_SECONDS=600
OTP_DAILY_LIMIT=10
OTP_IP_HOURLY_LIMIT=20
OTP_DEVICE_HOURLY_LIMIT=10
OTP_GLOBAL_HOURLY_LIMIT=1000
ENABLE_TEST_OTP_LOGIN=False
TEST_OTP_PHONE_NUMBERS=
TEST_OTP_CODE=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
OPENROUTER_API_KEY=replace-me
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=openai/gpt-4o-mini
MEDIA_ROOT=/app/media
WEB_CONCURRENCY=2
WEB_THREADS=2

# Django runtime
DJANGO_SETTINGS_MODULE=core.production
DJANGO_ENV=production
DEBUG=False
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters-long
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=True

# Required production services
DATABASE_URL=postgresql://user:password@database-host:5432/prepmate
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://redis-host:6379/1
CACHE_KEY_PREFIX=prepmate
CACHE_VERSION=3
CACHE_DEFAULT_TIMEOUT=300

# Passwordless mobile OTP (required in production)
OTP_PROVIDER=fast2sms
FAST2SMS_API_KEY=replace-me
FAST2SMS_OTP_ID=replace-me
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=
FAST2SMS_ENTITY_ID=
FAST2SMS_CONNECT_TIMEOUT_SECONDS=5
FAST2SMS_REQUEST_TIMEOUT_SECONDS=10
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_ISSUES_PER_WINDOW=3
OTP_ISSUE_WINDOW_SECONDS=600
OTP_DAILY_LIMIT=10
OTP_IP_HOURLY_LIMIT=20
OTP_DEVICE_HOURLY_LIMIT=10
OTP_GLOBAL_HOURLY_LIMIT=1000
ENABLE_TEST_OTP_LOGIN=False
TEST_OTP_PHONE_NUMBERS=
TEST_OTP_CODE=

# AI provider (required for resume optimization)
OPENROUTER_API_KEY=replace-me
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=openai/gpt-4o-mini
AI_TIMEOUT_SECONDS=25
OPTIMIZER_MAX_SUGGESTIONS=5
AI_COST_RESUME_OPTIMIZATION=10
AI_COST_SUGGESTION_REGENERATION=1

# Optional SMTP email delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PrepMate AI <noreply@example.com>
EMAIL_TIMEOUT=20

# JWT, uploads, and Gunicorn
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
MEDIA_ROOT=/app/media
WEB_CONCURRENCY=2
WEB_THREADS=2
PORT=8000
